{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Benman",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "options": {
                "cwd": "${workspaceFolder}/dist/benchmarks"
            },
            "args": [ "benman.py",
                // "--verbose",
                "--clear",
                "--build",
                "--fuzz",
                "--input",
                    // "all"
                    "fast"
                    // "iid_testing"
                    // "pending"
                    // "fast/nested_ifs.c"
                // , ">", "./dist/benchmarks/benman_output.txt"
            ]
        },
        {
            "label": "Explorer",
            "type": "shell",
            "command": "java",
            "dependsOrder": "sequence",
            "dependsOn": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "-Xss100m",
                "-Xms512m",
                "-Xmx10000m",
                "-Dsun.awt.disablegrab=true",
                "-jar",
                "../fizzer_explorer/target/ProgressExplorer-1.0-SNAPSHOT-jar-with-dependencies.jar",
                "../fizzer/dist/output/progress_recording"
            ]
        },
        {
            "label": "salat.py",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "options": {
                "cwd": "${workspaceFolder}/dist/benchmarks/salatd"
            },
            "args": [
                "salat.py",
                "--salac_dir", "../../tools/salac",
                "--salat_dir", "../../tools/salat",
                "--output_dir", "../../output",
                // "--verbose",
                "--input",
                    //"compile"
                    //"interpret"
                    "inputflow"
                    //"inputflow/cmdline02.c"
            ]
        },
        {
            "label": "clean dist",
            "type": "shell",
            "command": "rm -Rf *.html *_CRASH.txt *.gcov ./output ../output",
            "options": {
                "cwd": "${workspaceFolder}/dist/benchmarks"
            }
        },
        {
            "label": "TestCov",
            "type": "shell",
            "command": "${workspaceFolder}/../fizzer_eval/testcov/bin/testcov",
            "dependsOrder": "sequence",
            "dependsOn": [ "zip tests" ],
            "options": {
                "cwd": "${workspaceFolder}/dist/benchmarks"
            },
            "args": [ "--no-isolation", "--test-suite", "../output/test-suite/tests.zip",
                "fast/_.c"
            ]
        },
        {
            "label": "zip tests",
            "type": "shell",
            "command": "zip -r tests.zip ./*.xml",
            "options": {
                "cwd": "${workspaceFolder}/dist/output/test-suite"
            }
        },
        {
            "label": "squirrel",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "options": {
                "cwd": "${workspaceFolder}/dist/benchmarks"
            },
            "args": [
                "${workspaceFolder}/dist/squirrel.py",

                "--gfx",
                "--input_file",
                    "fast/_.c",
                "--jsonc",
                // "--m32",
                "--timeout", "60",
                "--memout", "3221225472", // 3 GB
                "--output_dir", "${workspaceFolder}/dist/output"
            ]
        },
    ]
}
