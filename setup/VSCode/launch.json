{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "run runner.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dist/fizzer.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/dist/benchmarks",
            "justMyCode": true,
            "args": [
                "--output_dir", "${workspaceFolder}/dist/output",

                "--jsonc",
                // "--skip_building",
                // "--skip_fuzzing",
                // "--silent_build",
                // "--m32",

                "--save_mapping",

                "--max_executions", "10000",
                "--max_seconds", "15",
                "--max_trace_length", "10000",
                "--max_exec_milliseconds", "250",
                "--max_exec_megabytes", "1024",
                "--max_bytes", "65536",
                "--opt_max_seconds", "10",
                "--opt_max_trace_length", "1000000",
                "--opt_max_exec_milliseconds", "3000",
                "--opt_max_exec_megabytes", " 2048",
                "--opt_max_bytes", "134217728",
                "--clear_output_dir",
                "--progress_recording",
                // "--silent_mode",
                "--render",
                // "--test_type", "testcomp",

                "--input_file",
                    "fast/_.c"
               ]
        },
        {
            "name": "run fuzzer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--path_to_target", "__target",
                "--path_to_sala", "__sala.json",
                "--max_executions", "10000000",
                "--max_seconds", "1000000",
                "--max_trace_length", "10000",
                "--max_exec_milliseconds", "250",
                "--max_exec_megabytes", "1024",
                "--max_bytes", "65536",
                "--opt_max_seconds", "10",
                "--opt_max_trace_length", "1000000",
                "--opt_max_exec_milliseconds", "3000",
                "--opt_max_exec_megabytes", " 2048",
                "--opt_max_bytes", "134217728",
                "--progress_recording",
                // "--silent_mode",
                "--render",
                // "--test_type", "testcomp",
                "--output_dir", "${workspaceFolder}/dist/output"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Benman @ dbg",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/benchmarks/benman.py",
            "console": "integratedTerminal",
            "args": [
                // "--verbose",
                "--clear",
                "--build",
                "--fuzz",
                "--input",
                    "all"
                    // "fast"
                    // "medium"
                    // "slow"
                    // "pending"

                    // "fast/_.c"
                ],
            "cwd": "${workspaceFolder}/dist/benchmarks",
            "justMyCode": true
        },
        {
            "name": "debug instrumenter",
            // On Windows use this:
                // "type": "cppvsdbg",
            // On Linux use this:
                "type": "cppdbg", "setupCommands": [{ "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--input", "${workspaceFolder}/dist/output/_.ll",
                "--output", "${workspaceFolder}/dist/output/__instrumented.ll",
                "--save_mapping"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist"
        },
        {
            "name": "salac.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/tools/salac/salac.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/dist/benchmarks/salatd",
            "justMyCode": true,
            "args": [
                "--bin", "${workspaceFolder}/dist/tools/salac/",
                "--jsonc",
                "--verbose",
                "--input",
                    "compile/_.c",

                "--output",
                    "${workspaceFolder}/dist/output"
            ]
        },
        {
            "name": "llvm2llvm",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": [
                "--input",
                    "_.ll"
                ]
        },
        {
            "name": "llvm2sala",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": [
                "--jsonc",
                "--input",
                    //"_.sim.ll",
                    //"__instrumented.sim.ll",
                    "_.ll"
                ]
        },
        {
            "name": "sala2sala",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": [
                "--input",
                    "_.raw.json",

                "--output", "."
                ]
        },
        {
            "name": "test_interpretation",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output/interpret",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": [
                "--input", "safety_func_ptr_call.json", "--data", "../../benchmarks/salatd/interpret/safety_func_ptr_call.01.txt"
                ]
        },
        {
            "name": "test_builder_for_interpretation",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": []
        },
        {
            "name": "test_input_flow",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output/inputflow",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": [
                "--input", "_.json", "--data", "../../benchmarks/salatd/inputflow/_.00.txt"
                ]
        },
        {
            "name": "test_builder_for_input_flow",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": []
        },
        {
            "name": "salat.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/benchmarks/salatd/salat.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/dist/benchmarks/salatd",
            "justMyCode": true,
            "args": [
                "--salac_dir", "../../tools/salac",
                "--salat_dir", "../../tools/salat",
                "--output_dir", "../../output",

                //"--jsonc",
                // "--verbose",
                "--input",
                    //"compile"
                    //"interpret"
                    //"inputflow"

                    "compile/_.c"
                ]
        },
        {
            "name": "run squirrel.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dist/squirrel.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/dist/benchmarks",
            "justMyCode": true,
            "args": [
                "--gfx",
                "--input_file",
                    "fast/_.c",
                "--jsonc",
                // "--m32",
                "--timeout", "60",
                "--memout", "3221225472", // 3 GB
                "--output_dir", "${workspaceFolder}/dist/output"
               ]
        },
        {
            "name": "run squirrel",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--gfx",
                "--sala",
                    "__sala.json",
                "--timeout", "1000000",
                "--out", "${workspaceFolder}/dist/output"
            ],
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}