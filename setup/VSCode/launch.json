{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "run runner.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dist/fizzer.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/dist/benchmarks",
            "justMyCode": true,
            "args": [
                "--output_dir", "${workspaceFolder}/dist/output",

                "--jsonc",
                // "--skip_building",
                // "--skip_fuzzing",
                // "--silent_build",
                // "--sala_executor",
                // "--m32",

                "--save_mapping",

                "--max_executions", "10000000",
                "--max_seconds", "15",
                "--max_trace_length", "10000",
                "--max_exec_milliseconds", "250",
                "--max_exec_megabytes", "1024",
                "--max_bytes", "65536",
                "--opt_max_seconds", "30",
                "--opt_max_trace_length", "10000000",
                "--opt_max_exec_milliseconds", "500",
                "--opt_max_exec_megabytes", " 2048",
                "--opt_max_bytes", "134217728",
                "--clear_output_dir",
                "--progress_recording",
                // "--silent_mode",
                // "--render",
                // "--test_type", "testcomp",
                // "--lsa_max_rounds", "100",
                // "--lsa_build_local_space", "1",
                // "--lsa_build_constraints", "1",
                // "--lsa_use_gradient_descent", "1",
                // "--lsa_use_bit_flips", "1",
                // "--lsa_use_random_fuzzing", "1",

                "--input_file",
                    "fast/_.c"
               ]
        },
        {
            "name": "run fuzzer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--path_to_target",
                    "__target",
                    // "source_target",
                "--path_to_sala",
                    "__sala.json",
                    // "source_sala.json",
                // "--sala_executor",
                "--max_executions", "10000000",
                "--max_seconds", "1000000",
                "--max_trace_length", "10000",
                "--max_exec_milliseconds", "250",
                "--max_exec_megabytes", "1024",
                "--max_bytes", "65536",
                "--opt_max_seconds", "0",
                // "--opt_max_trace_length", "1000000",
                // "--opt_max_exec_milliseconds", "3000",
                // "--opt_max_exec_megabytes", " 2048",
                // "--opt_max_bytes", "134217728",
                "--progress_recording",
                // "--silent_mode",
                // "--render",
                // "--test_type", "testcomp",
                // "--lsa_max_rounds", "100",
                // "--lsa_build_local_space", "1",
                // "--lsa_build_constraints", "1",
                // "--lsa_use_gradient_descent", "1",
                // "--lsa_use_bit_flips", "1",
                // "--lsa_use_random_fuzzing", "1",
                "--output_dir", "${workspaceFolder}/dist/output"
            ],
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Benman @ dbg",
            "type": "debugpy",
            "request": "launch",
            "program": "benman.py",
            "console": "integratedTerminal",
            "args": [
                "--verbose",
                "--clear",
                "--build",
                "--fuzz",
                "--input",
                    // "all"
                    // "fast"
                    // "medium"
                    // "slow"
                    // "pending"

                    // "fast/_.c"
                    "fast/int16_if_parabola.c"
                ],
            "cwd": "${workspaceFolder}/dist/benchmarks",
            "justMyCode": true
        },
        {
            "name": "debug composer",
            "type": "cppdbg",
            "setupCommands": [{ "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--input", "${workspaceFolder}/dist/output/source.ll",
                "--data", "${workspaceFolder}/dist/data/",
                "--output", "${workspaceFolder}/dist/output/source_composed.ll",
                //"--noargs"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output"
            // clang -O0 -g -S -emit-llvm -Wno-everything -fbracket-depth=1024 ./original.c -o source.ll
        },
        {
            "name": "debug instrumenter",
            "type": "cppdbg",
            "setupCommands": [{ "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }],
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--input", "${workspaceFolder}/dist/output/source.ll",
                "--output", "${workspaceFolder}/dist/output/source_instrumented.ll",
                "--save_mapping"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output"
        },
        {
            "name": "salac.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/tools/salac/salac.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/dist/benchmarks/salatd",
            "justMyCode": true,
            "args": [
                "--bin", "${workspaceFolder}/dist/tools/salac/",
                "--jsonc",
                "--verbose",
                "--input",
                    "compile/_.c",

                "--output",
                    "${workspaceFolder}/dist/output"
            ]
        },
        {
            "name": "llvm2llvm",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": [
                "--input",
                    "_.ll",
                ]
        },
        {
            "name": "llvm2sala",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": [
                "--jsonc",
                "--entry", "__fizzer_private_entry_function",
                "--input",
                    //"_.sim.ll",
                    "__instrumented.sim.ll",
                    //"_.ll"
                ]
        },
        {
            "name": "sala2sala",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": [
                "--jsonc",
                "--input",
                    "__sala.json",
                    //"__instrumented.raw.json",

                "--output", "__sala.opt.json"
                ]
        },
        {
            "name": "test_interpretation",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output/interpret",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": [
                "--input", "cmdline01.json", "--data", "../../benchmarks/salatd/interpret/cmdline01.01.txt"
                ]
        },
        {
            "name": "test_builder_for_interpretation",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": []
        },
        {
            "name": "test_input_flow",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output/inputflow",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": [
                "--input", "cmdline01.json", "--data", "../../benchmarks/salatd/inputflow/cmdline01.00.txt"
                ]
        },
        {
            "name": "test_builder_for_input_flow",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "args": []
        },
        {
            "name": "salat.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/benchmarks/salatd/salat.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/dist/benchmarks/salatd",
            "justMyCode": true,
            "args": [
                "--salac_dir", "../../tools/salac",
                "--salat_dir", "../../tools/salat",
                "--output_dir", "../../output",

                //"--jsonc",
                // "--verbose",
                "--input",
                    //"compile"
                    //"interpret"
                    //"inputflow"

                    "compile/_.c"
                ]
        },
        {
            "name": "run squirrel.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dist/squirrel.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/dist/benchmarks",
            "justMyCode": true,
            "args": [
                "--gfx",
                "--input_file",
                    "fast/_.c",
                "--jsonc",
                // "--m32",
                "--timeout", "60",
                "--memout", "3221225472", // 3 GB
                "--output_dir", "${workspaceFolder}/dist/output"
               ]
        },
        {
            "name": "run squirrel",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--gfx",
                "--sala",
                    "__sala.json",
                "--timeout", "1000000",
                "--out", "${workspaceFolder}/dist/output"
            ],
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "cwd": "${workspaceFolder}/dist/output",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}